{
  "expo": {
    "name": "Left2Chef",
    "slug": "left2chef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.left2chef.app"
    },
    "android": {
      "package": "com.left2chef.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon.png",
        "backgroundColor": "#1A1A2E"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "left2chef",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0dc6d29-a12c-4eb2-b267-75d5c00d0f97"
      }
    }
  }
}
